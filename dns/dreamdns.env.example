# One file per record: install as /etc/dreamdns/<instance>.env (mode 600,
# owner root) and enable dreamdns@<instance>.timer, e.g. instance
# "home.mydomain.com". Shared settings such as DH_API_KEY may instead go in
# /etc/dreamdns/common.env.

# Panel > API: create a key with only the dns:read and dns:write permissions.
DH_API_KEY=dhapi_replace_me
DNS_ZONE=mydomain.com
DNS_NAME=subdomain

# Optional
#DNS_TYPES="A AAAA"
#RECHECK_SECS=14400
